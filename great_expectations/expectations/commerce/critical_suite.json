{
  "expectation_suite_name": "commerce.critical",
  "meta": {
    "notes": "Critical checks for OpenLake Commerce gold and silver datasets."
  },
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "order_id" },
      "meta": { "dataset": "silver.orders" }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": { "column": "order_id" },
      "meta": { "dataset": "silver.orders" }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "order_status",
        "value_set": ["created", "confirmed", "paid", "packed", "shipped", "delivered", "cancelled", "returned"]
      },
      "meta": { "dataset": "silver.orders" }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "order_total", "min_value": 0 },
      "meta": { "dataset": "silver.orders" }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "amount", "min_value": 0 },
      "meta": { "dataset": "silver.payments" }
    },
    {
      "expectation_type": "expect_compound_columns_to_be_unique",
      "kwargs": { "column_list": ["source_table", "event_id"] },
      "meta": { "dataset": "bronze.raw_cdc_events", "purpose": "duplicate CDC event detection" }
    },
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": { "min_value": 1, "max_value": 10000000 },
      "meta": { "purpose": "row count anomaly guard" }
    }
  ]
}
