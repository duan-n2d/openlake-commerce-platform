PROJECT_NAME=openlake-commerce-platform
COMPOSE_PROJECT_NAME=openlake

# Images are pinned but overrideable so the stack can be upgraded deliberately.
POSTGRES_IMAGE=postgres:16.4
KAFKA_IMAGE=apache/kafka:4.0.0
DEBEZIUM_IMAGE=debezium/connect:3.1.0.Final
FLINK_IMAGE=flink:1.20.0-scala_2.12-java17
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
POLARIS_IMAGE=apache/polaris:1.5.0
TRINO_IMAGE=trinodb/trino:476
SUPERSET_IMAGE=apache/superset:4.1.1
DATAHUB_VERSION=v1.0.0

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=commerce
POSTGRES_USER=commerce_app
POSTGRES_PASSWORD=commerce_app
POSTGRES_REPLICATION_USER=debezium
POSTGRES_REPLICATION_PASSWORD=debezium

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:29092
DEBEZIUM_CONNECT_URL=http://debezium:8083
DEBEZIUM_TOPIC_PREFIX=openlake_pg

MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=openlake

POLARIS_URI=http://polaris:8181/api/catalog
POLARIS_MANAGEMENT_URI=http://polaris:8181/api/management
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=s3cr3t
POLARIS_REALM=POLARIS

TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=openlake
TRINO_CATALOG=iceberg
TRINO_SCHEMA=gold

API_HOST=0.0.0.0
API_PORT=8000
API_CACHE_TTL_SECONDS=30

DAGSTER_HOME=/opt/dagster/dagster_home
OPENLINEAGE_URL=http://openlineage-mock:5000
DATAHUB_GMS_URL=http://datahub-gms:8080
SUPERSET_SECRET_KEY=change-me-for-local-dev
